# Copying this file is optional. Start.command creates .env.local with random secrets.
CREVE_DATASOURCE_URL=jdbc:postgresql://localhost:55432/creve_modular
CREVE_DATASOURCE_USERNAME=creve
CREVE_DATASOURCE_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
CREVE_SESSION_HASH_SALT=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CREVE_BASE_URL=http://localhost:8080
PORT=8080
CREVE_DB_PORT=55432
CREVE_BOOTSTRAP_ADMIN=true
CREVE_ADMIN_EMAIL=admin@creve.local
CREVE_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_RANDOM_CHARACTERS
# Keep false until terms/privacy text and deployment/security are reviewed.
CREVE_POSTING_ENABLED=false
CREVE_PUBLIC_CONTENT_DIR=./config/public
CREVE_SOCIAL_URL=
